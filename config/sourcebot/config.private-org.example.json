{
  "$schema": "https://raw.githubusercontent.com/sourcebot-dev/sourcebot/v5.1.10/schemas/v3/index.json",
  "connections": {
    "github-org": {
      "type": "github",
      "token": { "env": "GITHUB_TOKEN" },
      "orgs": ["your-org"],
      "exclude": { "archived": true, "forks": true }
    }
  }
}
