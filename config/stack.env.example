# ---------- Shared ----------
# Nothing here talks to a cloud service: models run in Ollama, engines run in this compose project.
POSTGRES_USER=stack
POSTGRES_PASSWORD=change-me
# ---------- Inference backend ----------
# This is the ONLY place document text (LightRAG) and memory text (Hindsight) are sent for processing.
# Point it at something your organisation controls or has approved:
#   ollama  : local Ollama. *_BASE_URL is the server root. Default = the ollama container in docker/compose.yaml;
#             Ollama on the host (Apple silicon): http://host.docker.internal:11434 + docker/compose.host-ollama.yaml
#   openai  : any OpenAI-compatible endpoint (Azure OpenAI in your tenant, Bedrock/Vertex behind a LiteLLM proxy,
#             internal vLLM/TGI, an approved vendor). *_BASE_URL is the .../v1 base URL, *_API_KEY the token.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_API_KEY=ollama
LLM_MODEL=gpt-oss:20b
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://ollama:11434
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3
EMBED_DIM=1024
# Hindsight only speaks the OpenAI embeddings API: Ollama root + /v1, or the same /v1 URL as EMBED_BASE_URL
HINDSIGHT_EMBED_BASE_URL=http://ollama:11434/v1

# ---------- Hindsight ----------
# API key every REST/MCP call to Hindsight must carry (the gateway holds it; agents never see it)
HINDSIGHT_API_KEY=change-me-hindsight-key
# login key for the control-plane UI on :9999
HINDSIGHT_CP_ACCESS_KEY=change-me-ui-key
# local (cross-encoder, one-time HuggingFace download) | rrf (no model at all)
HINDSIGHT_RERANKER=local

# ---------- LightRAG ----------
LIGHTRAG_API_KEY=change-me-lightrag-key

# ---------- Sourcebot (generate: openssl rand -base64 33 / openssl rand -base64 24) ----------
SOURCEBOT_AUTH_SECRET=change-me-000000000000000000000000000
SOURCEBOT_ENCRYPTION_KEY=change-me-0000000000000000000000
SOURCEBOT_AUTH_URL=http://localhost:3000
# token Sourcebot uses to list/clone repos (referenced from config/sourcebot/config.json)
GITHUB_TOKEN=
# API key created in the Sourcebot UI; used by the gateway to search on behalf of users
SOURCEBOT_API_KEY=

# ---------- Ingest service ----------
# used by the ingest plugin (REST) and by mcp-atlassian (the live fallback); Server/DC: set CONFLUENCE_PERSONAL_TOKEN instead
CONFLUENCE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_USER=you@example.com
CONFLUENCE_TOKEN=
CONFLUENCE_PERSONAL_TOKEN=
BACKSTAGE_URL=http://backstage.internal:7007
BACKSTAGE_TOKEN=
# plugins/jama.py (Jama Connect REST v1: basic auth user + API token)
JAMA_URL=
JAMA_USER=
JAMA_TOKEN=
GIT_DOC_GLOBS=README.md,docs/**/*.md,adr/**/*.md,runbooks/**/*.md
INGEST_WEBHOOK_SECRET=change-me
INGEST_SCHEDULE_CRON=0 2 * * *
