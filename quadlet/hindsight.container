[Unit]
Description=Hindsight agent memory
Requires=postgres.service ollama.service
After=postgres.service ollama.service

[Container]
Image=ghcr.io/vectorize-io/hindsight:0.9.2
ContainerName=hindsight
Network=stack.network
PublishPort=127.0.0.1:8888:8888
PublishPort=127.0.0.1:9999:9999
ShmSize=1g
# stack.env is generated from .env by scripts/gen-scopes.py quadlet (carries the derived HINDSIGHT_API_* names)
EnvironmentFile=%h/agent-context-stack/quadlet/stack.env
Environment=HINDSIGHT_API_LLM_OLLAMA_NUM_CTX=32768
Environment=HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
Environment=HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
Environment=HINDSIGHT_API_WORKER_ID=hindsight-1
Environment=HINDSIGHT_CP_DATAPLANE_API_URL=http://localhost:8888

[Service]
Restart=always

[Install]
WantedBy=default.target
