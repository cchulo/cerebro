[Unit]
Description=Ollama local inference

[Container]
Image=docker.io/ollama/ollama:0.33.3
ContainerName=ollama
Network=stack.network
Volume=ollama.volume:/root/.ollama
PublishPort=127.0.0.1:11434:11434
Environment=OLLAMA_KEEP_ALIVE=30m
Environment=OLLAMA_NUM_PARALLEL=2
# NVIDIA (CDI): uncomment after `nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml`
# AddDevice=nvidia.com/gpu=all

[Service]
Restart=always

[Install]
WantedBy=default.target
