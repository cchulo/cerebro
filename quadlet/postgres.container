[Unit]
Description=Shared PostgreSQL (pgvector) for Hindsight, LightRAG, Sourcebot

[Container]
Image=docker.io/pgvector/pgvector:0.8.2-pg17
ContainerName=postgres
Network=stack.network
Volume=pgdata.volume:/var/lib/postgresql/data
Volume=%h/agent-context-stack/config/postgres/init.sql:/docker-entrypoint-initdb.d/init.sql:ro,Z
EnvironmentFile=%h/agent-context-stack/.env
Environment=POSTGRES_DB=postgres
ShmSize=512m
HealthCmd=pg_isready -U ${POSTGRES_USER}
HealthInterval=5s
HealthRetries=20

[Service]
Restart=always

[Install]
WantedBy=default.target
