[Unit]
Description=CodeGraphContext MCP for scope infra
Requires=scope-infra-falkordb.service
After=scope-infra-falkordb.service

[Container]
Image=localhost/stack-codegraph-mcp:latest
ContainerName=codegraph-infra
Network=stack.network
Volume=stack-repos-infra:/workspace:ro
Volume=stack-cgc-infra:/home/cgc/.codegraphcontext
Environment=DEFAULT_DATABASE=falkordb FALKORDB_HOST=falkordb-infra FALKORDB_PORT=6379

[Service]
Restart=always

[Install]
WantedBy=default.target
