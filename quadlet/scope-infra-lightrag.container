[Unit]
Description=LightRAG docs graph for scope infra
Requires=postgres.service ollama.service
After=postgres.service ollama.service

[Container]
Image=ghcr.io/hkuds/lightrag:v1.5.7
ContainerName=lightrag-infra
Network=stack.network
Volume=stack-lightrag-infra:/app/data
EnvironmentFile=%h/agent-context-stack/quadlet/stack.env
Environment=HOST=0.0.0.0
Environment=PORT=9621
Environment=WORKING_DIR=/app/data/rag_storage
Environment=INPUT_DIR=/app/data/inputs
Environment=OLLAMA_LLM_NUM_CTX=32768
Environment=LLM_TIMEOUT=600
Environment=MAX_PARALLEL_INSERT=2
Environment=WHITELIST_PATHS=/health
Environment=LIGHTRAG_KV_STORAGE=PGKVStorage
Environment=LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage
Environment=LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
Environment=LIGHTRAG_GRAPH_STORAGE=PGTableGraphStorage
Environment=POSTGRES_HOST=postgres
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_DATABASE=lightrag
Environment=POSTGRES_VECTOR_INDEX_TYPE=HNSW
Environment=WORKSPACE=scope_infra

[Service]
Restart=always

[Install]
WantedBy=default.target
