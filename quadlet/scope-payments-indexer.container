[Unit]
Description=Index repos for scope payments
Requires=scope-payments-falkordb.service
After=scope-payments-falkordb.service

[Container]
Image=localhost/stack-codegraph-mcp:latest
ContainerName=indexer-payments
Network=stack.network
Volume=stack-repos-payments:/workspace
Volume=stack-cgc-payments:/home/cgc/.codegraphcontext
Volume=%h/agent-context-stack/index/index-repo.sh:/usr/local/bin/index-repo.sh:ro,Z
EnvironmentFile=%h/agent-context-stack/.env
Environment=DEFAULT_DATABASE=falkordb FALKORDB_HOST=falkordb-payments FALKORDB_PORT=6379
Environment=GIT_DOC_REPOS=https://github.com/your-org/payments.git,https://github.com/your-org/ledger.git
Entrypoint=/bin/bash
Exec=/usr/local/bin/index-repo.sh all

[Service]
Type=oneshot
