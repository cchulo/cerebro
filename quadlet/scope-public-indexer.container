[Unit]
Description=Index repos for scope public
Requires=scope-public-falkordb.service
After=scope-public-falkordb.service

[Container]
Image=localhost/stack-codegraph-mcp:latest
ContainerName=indexer-public
Network=stack.network
Volume=stack-repos-public:/workspace
Volume=stack-cgc-public:/home/cgc/.codegraphcontext
Volume=%h/agent-context-stack/index/index-repo.sh:/usr/local/bin/index-repo.sh:ro,Z
EnvironmentFile=%h/agent-context-stack/quadlet/stack.env
Environment=DEFAULT_DATABASE=falkordb-remote FALKORDB_HOST=falkordb-public FALKORDB_PORT=6379
Environment=GIT_DOC_REPOS=https://github.com/your-org/platform-docs.git,https://github.com/your-org/shared-libs.git
Entrypoint=/bin/bash
Exec=/usr/local/bin/index-repo.sh all

[Service]
Type=oneshot
