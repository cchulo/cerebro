# secrets.env: every value the stack reads from the environment. Copy to secrets.env (gitignored) and fill what you
# use; list the same names under `secrets.keys` in cerebro.yaml. compose reads it with --env-file; the kubernetes
# target builds the Secret `cerebro-secrets` from it at apply time. Nothing rendered ever contains a value.
# Generate random values with: openssl rand -base64 24

# --- always (base units)
POSTGRES_PASSWORD=                  # openssl rand -base64 24; user `cerebro`, one database per engine
LIGHTRAG_API_KEY=                   # openssl rand -base64 24; X-API-Key every docs-<scope> server requires
HINDSIGHT_API_KEY=                  # openssl rand -base64 24; bearer the memory unit requires (tenant key)
INGEST_WEBHOOK_SECRET=              # openssl rand -base64 24; X-Ingest-Secret for POST /sync/* and /webhook/*; empty = unauthenticated

# --- identity.mode none with allow_remote: true
CEREBRO_TOKEN=                      # openssl rand -base64 24; the one bearer every client must send

# --- identity.mode builtin (Keycloak unit)
CEREBRO_AUTH_ADMIN_USER=admin       # Keycloak bootstrap admin (KC_BOOTSTRAP_ADMIN_USERNAME)
CEREBRO_AUTH_ADMIN_PASSWORD=        # openssl rand -base64 24
CEREBRO_SEED_PASSWORD=              # optional: temporary first-login password for seeded users; generated and printed once when empty

# --- identity.token_validation: introspection (name chosen in identity.introspection.client_secret_env)
# CEREBRO_INTROSPECTION_SECRET=

# --- inference.llm / inference.embed with provider openai (name chosen in api_key_env)
# LLM_API_KEY=
# EMBED_API_KEY=

# --- code units and the git docs plugin
GITHUB_TOKEN=                       # clone auth for private github.com repositories; empty for public ones

# --- source plugins (leave a block empty and that plugin reports "not configured")
CONFLUENCE_URL=                     # https://your-site.atlassian.net/wiki  (also read by the mcp-confluence upstream)
CONFLUENCE_USER=
CONFLUENCE_TOKEN=
CONFLUENCE_PERSONAL_TOKEN=          # Server / Data Center only, for mcp-atlassian
BACKSTAGE_URL=                      # https://backstage.internal
BACKSTAGE_TOKEN=                    # optional
JAMA_URL=                           # https://jama.internal
JAMA_USER=
JAMA_TOKEN=

# --- optional
# HINDSIGHT_CP_ACCESS_KEY=          # Hindsight control-plane UI login (engines.memory.options.cp_access_key_secret)
# GIT_DOC_GLOBS=README.md,docs/**/*.md   # default globs of the git docs plugin (not a secret)
