# tests/e2e/secrets.env.example -> tests/e2e/secrets.env (gitignored) with fresh random values:
#   python3 -c 'import re,secrets;print(re.sub("CHANGE_ME",lambda m:secrets.token_hex(24),open("tests/e2e/secrets.env.example").read()),end="")' > tests/e2e/secrets.env
# Every name here is listed under secrets.keys in cerebro.e2e.yaml; compose substitutes them at run time.
POSTGRES_PASSWORD=CHANGE_ME
LIGHTRAG_API_KEY=CHANGE_ME
HINDSIGHT_API_KEY=CHANGE_ME
INGEST_WEBHOOK_SECRET=CHANGE_ME
GITHUB_TOKEN=
# the mocks (tests/mock) accept any credentials; the URLs are the compose service names of compose.mocks.yaml
CONFLUENCE_URL=http://mock-confluence:8000
CONFLUENCE_USER=test
CONFLUENCE_TOKEN=test
BACKSTAGE_URL=http://mock-backstage:8000
BACKSTAGE_TOKEN=
# static bearer tokens, one per persona (identity.tokens in cerebro.e2e.yaml); `cerebro smoke --as alice` reads them here
CEREBRO_TOKEN_ALICE=CHANGE_ME
CEREBRO_TOKEN_BOB=CHANGE_ME
CEREBRO_TOKEN_CAROL=CHANGE_ME
CEREBRO_TOKEN_DAVE=CHANGE_ME
CEREBRO_TOKEN_CI=CHANGE_ME
